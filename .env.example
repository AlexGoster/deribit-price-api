# Example development values only. Copy to .env; do not commit real credentials.
POSTGRES_USER=prices
POSTGRES_PASSWORD=change-this-local-demo-password
POSTGRES_DB=prices
DATABASE_URL=postgresql+asyncpg://prices:change-this-local-demo-password@localhost:5432/prices
DERIBIT_BASE_URL=https://www.deribit.com/api/v2
POLL_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=10
RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=1
COLLECTOR_ENABLED=true
